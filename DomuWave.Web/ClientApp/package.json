{
    "name": "domuwave-frontend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build --mode development",
        "build:prod": "vite build --mode production",
        "build:dev": "vite build --mode development",
        "postbuild": "npm run copy-dist && npm run copy-guide",
        "copy-dist": "copyfiles -u 1 dist/**/* ../../DomuWave.Web/wwwroot/",
        "clean-guide": "node -e \"const fs=require('fs'),p='../../DomuWave.Web/wwwroot/guide';fs.rmSync(p,{recursive:true,force:true})\"",
        "copy-guide": "npm run clean-guide && copyfiles -u 2 src/guide/*.md ../../DomuWave.Web/wwwroot/guide/",
        "preview": "vite preview",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "eslint . --fix",
        "lint": "run-s lint:*",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "@primeuix/themes": "^1.2.1",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "animate.css": "^4.1.1",
        "axios": "^1.13.5",
        "dompurify": "^3.4.9",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "markdown-it": "^14.2.0",
        "pinia": "^3.0.1",
        "primeicons": "^7.0.0",
        "primevue": "^4.3.6",
        "toastr": "^2.1.4",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "vue-toastification": "^2.0.0-rc.5",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vitejs/plugin-vue-jsx": "^4.1.2",
        "@vue/eslint-config-prettier": "^10.2.0",
        "copyfiles": "^2.4.1",
        "eslint": "^9.22.0",
        "eslint-plugin-oxlint": "^0.16.0",
        "eslint-plugin-vue": "~10.0.0",
        "globals": "^16.0.0",
        "npm-run-all2": "^7.0.2",
        "oxlint": "^0.16.0",
        "prettier": "3.5.3",
        "vite": "^6.2.4",
        "vite-plugin-vue-devtools": "^7.7.2"
    }
}
