    "HealthChecksUI": {},
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Exceptions"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Hangfire": "Warning",
                "System": "Warning",
                "CPQ.Core.Startups.RecurringJobsHostedService": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:o}] |{Level:u4}| #{ThreadId} [{Application} - {MachineName}] {SourceContext} {Message}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": ".\\Logs\\domuwave-unified_.log",
                    "outputTemplate": "[{Timestamp:o}] |{Level:u4}| #{ThreadId} [{Application} - {MachineName}] {SourceContext} {Message}{NewLine}{Exception}",
                    "rollingInterval": "Day",
                    "fileSizeLimitBytes": 52428800,
                    "retainedFileCountLimit": 7,
                    "rollOnFileSizeLimit": true,
                    "shared": false
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
        "Destructure": [
            {
                "Name": "ToMaximumDepth",
                "Args": { "maximumDestructuringDepth": 4 }
            },
            {
                "Name": "ToMaximumStringLength",
                "Args": { "maximumStringLength": 100 }
            },
            {
                "Name": "ToMaximumCollectionCount",
                "Args": { "maximumCollectionCount": 10 }
            }
        ],
        "Properties": {
            "Application": "DomuWaveUnified",
            "tag": "DomuWaveUnified"
        }
    },
    "JobSettings": {
        "JobServer": {
            "ServerKey": "DomuWave",
            "SchemaName": "DomuWave",
            "UserName": "root",
            "Pwd": "root4ever!",
            "Queue": [ "critical", "default" ],
            "IamJobServer": true,
            "ProlongExpirationDay": 365,
            "QueueDbConnectionString": "Server=inb6pbf3df.zonein.mssql-aruba.it;Database=MSSql217693;User Id=MSSql217693;Password=V1z@D0mU5!;TrustServerCertificate=true"
        },
        "Jobs": []
    },
    "OxCore": {
        "Microservices": { "authorization-base-uri": "http://localhost:40300" },
        "UseAuthIntegration": false,
        "UseEmbeddedAuth": true,
        "CacheAuthExpireMinute": 20,
        "CorsAllowedUri": "*",
        "AddInPluginFolder": null,
        "MediatorAssemly": "DomuWave.Services",
        "ConsumerKeyUrl": "/api/DomuWave",
        "AppDomainName": "DomuWave_App",
        "TraceRequest": true,
        "TemplatePrefix": "omx_",
        "SignalR": {
            "Start": false,
            "MaxRetries": 20,
            "DelayInSecondToRetry": 15,
            "Hubs": []
        },
        "Nh": {
            "Factories": [
                {
                    "Key": "DomuWave",
                    "IsDefault": true,
                    "ConfigurationPath": "/config/sessionfactory-DomuWave.cfg.xml",
                    "ConnectionStringName": "sql-DomuWave_SDB",
                    "FluentlyAssembly": [ "DomuWave.Services", "CPQ.Core" ],
                    "HbmAssembly": [ "DomuWave.Services", "CPQ.Core" ]
                },
                {
                    "Key": "AUTH",
                    "IsDefault": false,
                    "ConfigurationPath": "/config/sessionfactory-AUTH.cfg.xml",
                    "ConnectionStringName": "sql-DomuWave_SDB",
                    "FluentlyAssembly": [ "Auth.Services", "CPQ.Core" ],
                    "HbmAssembly": [ "Auth.Services", "CPQ.Core" ]
                }
            ]
        }
    },
