<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ── Build Vue frontend prima della compilazione ── -->
  <Target Name="BuildClientApp" BeforeTargets="Build">
    <Message Importance="high" Text="Building Vue frontend (development)..." />
    <Exec WorkingDirectory="..\DomuWave.Web\ClientApp" Command="npm install" />
    <Exec WorkingDirectory="..\DomuWave.Web\ClientApp" Command="npm run build" />
  </Target>

  <Target Name="PublishClientApp" BeforeTargets="Publish">
    <Message Importance="high" Text="Building Vue frontend (production)..." />
    <Exec WorkingDirectory="..\DomuWave.Web\ClientApp" Command="npm install" />
    <Exec WorkingDirectory="..\DomuWave.Web\ClientApp" Command="npm run build:prod" />
    <ItemGroup>
      <DistFiles Include="..\DomuWave.Web\ClientApp\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <RuntimeIdentifier>win-x86</RuntimeIdentifier>
	  <SelfContained>true</SelfContained>
	  <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1572;1573;1591</NoWarn>
    <!-- Serve i file statici dalla wwwroot del progetto Web -->
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- Hosting IIS in-process -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UserSecretsId>b3c8970e-32cb-4542-9186-d381ce100265</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Content Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

