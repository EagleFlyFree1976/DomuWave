{
  "_comment": "Modalità single-database: sql-auth punta allo stesso DB di sql-DomuWave. Le tabelle auth vivono nello schema 'auth'. Per tornare a due DB separati: ripristinare sql-auth su Eagle_Auth e cambiare ConfigurationPath su sessionfactory-AUTH-dbo.cfg.xml.",
  "OxCore": {
    "Nh": {
      "Factories": [
        {
          "Key": "DomuWave",
          "IsDefault": true,
          "ConfigurationPath": "/config/sessionfactory-DomuWave.cfg.xml",
          "ConnectionStringName": "sql-DomuWave",
          "FluentlyAssembly": [ "DomuWave.Services", "CPQ.Core" ],
          "HbmAssembly": [ "DomuWave.Services", "CPQ.Core" ]
        },
        {
          "Key": "AUTH",
          "IsDefault": false,
          "ConfigurationPath": "/config/sessionfactory-AUTH.cfg.xml",
          "ConnectionStringName": "sql-auth",
          "FluentlyAssembly": [ "Auth.Services", "CPQ.Core" ],
          "HbmAssembly": [ "Auth.Services", "CPQ.Core" ]
        }
      ]
    }
  },
  "ConnectionStrings": {
    "sql-auth": "Server=__SERVER__;Database=DomuWave;User Id=__USER__;Password=__PASSWORD__;TrustServerCertificate=true"
  }
}
