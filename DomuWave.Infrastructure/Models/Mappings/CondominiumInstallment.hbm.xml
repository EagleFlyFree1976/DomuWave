<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.CondominiumInstallment, DomuWave.Services" table="CondominiumInstallment" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='CondominiumInstallment'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Services.Models.Condominium, DomuWave.Services" column="CondominiumId" not-null="true" />
    <many-to-one name="Budget" class="DomuWave.Services.Models.Budget, DomuWave.Services" column="BudgetId" />

    <property name="Name" column="Description" type="String" length="200" not-null="true" />
    <property name="Description" column="Notes" type="String" length="500" />
        <property name="InstallmentNumber" column="InstallmentNumber" type="Int32" not-null="true" />
    <property name="DueDate" column="DueDate" type="DateTime" not-null="true" />
    <property name="TotalAmount" column="TotalAmount" type="Decimal" not-null="true" />
    <property name="Status" column="Status" type="String" length="50" not-null="true" />
    <property name="Notes" column="Notes" type="String" length="500" insert="false" update="false" />

    <property name="CreatedBy" column="CreatedById" type="Int32" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="CreationDate"          column="CreationDate"          type="DateTime" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="DateTime" />

    <bag name="Fees" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="InstallmentId" />
      <one-to-many class="DomuWave.Services.Models.CondominiumFee, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
