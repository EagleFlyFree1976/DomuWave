<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.RealEstateUnit, DomuWave.Services" table="RealEstateUnit" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='RealEstateUnit'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Services.Models.Condominium, DomuWave.Services" column="CondominiumId" not-null="true" />
    <many-to-one name="Building"   class="DomuWave.Services.Models.Building,   DomuWave.Services" column="BuildingId"   lazy="false" fetch="join" />
    <many-to-one name="Staircase"  class="DomuWave.Services.Models.Staircase,  DomuWave.Services" column="StaircaseId"  lazy="false" fetch="join" />
    <property name="Floor" column="Floor" type="Int32" not-null="true" />
    <property name="InternalNumber" column="InternalNumber" type="String" length="40" />
    <property name="Sheet"          column="Sheet"          type="String" length="20" />
    <property name="Parcel"         column="Parcel"         type="String" length="20" />
    <property name="Subordinate"    column="Subordinate"    type="String" length="20" />
    <property name="Category"       column="Category"       type="String" length="10" />
    <property name="CadastralIncome" column="CadastralIncome" type="Decimal" />
    <property name="AreaSqm" column="AreaSqm" type="Decimal" />
    <property name="Rooms" column="Rooms" type="Decimal" />
    <property name="UnitType" column="UnitType" type="String" length="50" not-null="true" />
    <property name="OccupancyStatus" column="OccupancyStatus" type="String" length="50" not-null="true" />
    <property name="Notes" column="Notes" type="String" length="1000" insert="false" update="false" />
    <property name="DisplayName" column="DisplayName" type="String" length="200" />
    <property name="IsDisplayNameOverridden" column="IsDisplayNameOverridden" type="Boolean" not-null="true" />
    <property name="NumeroAbitanti" column="NumeroAbitanti" type="Int32" not-null="true" />
    <property name="IsActive" column="IsActive" type="Boolean" not-null="true" />

    <many-to-one name="BillingGroup" class="DomuWave.Services.Models.BillingGroup, DomuWave.Services" column="BillingGroupId" />

    <property name="CreatedBy" column="CreatedById" type="Int32" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="IsEnabled" column="IsActive" type="Boolean" insert="false" update="false" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

    <bag name="Owners" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="UnitId" />
      <one-to-many class="DomuWave.Services.Models.UnitOwner, DomuWave.Services" />
    </bag>

    <bag name="Tenants" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="UnitId" />
      <one-to-many class="DomuWave.Services.Models.UnitTenant, DomuWave.Services" />
    </bag>

    <bag name="Millesimals" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="UnitId" />
      <one-to-many class="DomuWave.Services.Models.UnitMillesimal, DomuWave.Services" />
    </bag>

    <bag name="ExpenseAllocations" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="UnitId" />
      <one-to-many class="DomuWave.Services.Models.ExpenseAllocation, DomuWave.Services" />
    </bag>

    <bag name="Fees" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="UnitId" />
      <one-to-many class="DomuWave.Services.Models.CondominiumFee, DomuWave.Services" />
    </bag>

    <bag name="Receipts" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="UnitId" />
      <one-to-many class="DomuWave.Services.Models.Receipt, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
