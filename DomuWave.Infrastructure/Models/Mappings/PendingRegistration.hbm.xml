<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.PendingRegistration, DomuWave.Services"
         table="PendingRegistration" lazy="true">

    <id name="Id" column="Id" type="Guid">
      <generator class="assigned" />
    </id>

    <property name="Email"        column="Email"        type="String"   length="200" not-null="true" />
    <property name="PasswordHash" column="PasswordHash" type="String"   length="500" not-null="true" />
    <property name="TenantName"   column="TenantName"   type="String"   length="200" not-null="true" />
    <property name="Status"       column="Status"       type="Int32"    not-null="true" />
    <property name="CreatedAt"    column="CreatedAt"    type="datetime2" not-null="true" />
    <property name="ConfirmedAt"  column="ConfirmedAt"  type="datetime2" />
    <property name="ExpiresAt"    column="ExpiresAt"    type="datetime2" not-null="true" />

  </class>

</hibernate-mapping>
