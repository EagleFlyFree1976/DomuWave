<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Domain"
                   namespace="DomuWave.Domain.Models">

  <class name="DomuWave.Domain.Models.Message, DomuWave.Services" table="Message" lazy="true">

    <id name="Id" column="Id" type="Int64">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Message'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Domain.Models.Condominium, DomuWave.Services" column="CondominiumId" not-null="true" />
    <many-to-one name="ParentMessage" class="DomuWave.Domain.Models.Message, DomuWave.Services" column="ParentMessageId" />

    <property name="Name" column="Subject" type="String" length="200" not-null="true" />
    <property name="Description" column="Content" type="StringClob" not-null="true" />
    <property name="SenderId" column="SenderId" type="Int64" not-null="true" />
    <property name="RecipientId" column="RecipientId" type="Int64" not-null="true" />
    <property name="Subject" column="Subject" type="String" length="200" not-null="true" insert="false" update="false" />
    <property name="Content" column="Content" type="StringClob" not-null="true" insert="false" update="false" />
    <property name="IsRead" column="IsRead" type="Boolean" not-null="true" />
    <property name="ReadDate" column="ReadDate" type="DateTime" />
    <property name="AttachmentPath" column="AttachmentPath" type="String" length="500" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />

    <bag name="Replies" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="ParentMessageId" />
      <one-to-many class="DomuWave.Domain.Models.Message, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
