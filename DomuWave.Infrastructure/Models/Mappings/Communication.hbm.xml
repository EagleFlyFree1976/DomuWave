<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.Communication, DomuWave.Services" table="Communication" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Communication'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Services.Models.Condominium, DomuWave.Services" column="CondominiumId" not-null="true" />

    <property name="Name" column="Title" type="String" length="200" not-null="true" />
    <property name="Description" column="Content" type="StringClob" />
    <property name="Title" column="Title" type="String" length="200" not-null="true" insert="false" update="false" />
    <property name="Content" column="Content" type="StringClob" insert="false" update="false" />
    <property name="CommunicationType" column="CommunicationType" type="String" length="50" not-null="true" />
    <property name="Priority" column="Priority" type="String" length="50" not-null="true" />
    <property name="PublicationDate" column="PublicationDate" type="DateTime" not-null="true" />
    <property name="ExpirationDate" column="ExpirationDate" type="DateTime" />
    <property name="SendEmail" column="SendEmail" type="Boolean" not-null="true" />
    <property name="EmailSentAt" column="EmailSentAt" type="DateTime" />
    <property name="IsVisible" column="IsVisible" type="Boolean" not-null="true" />
    <property name="AttachmentPath" column="AttachmentPath" type="String" length="500" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />

    <bag name="Reads" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CommunicationId" />
      <one-to-many class="DomuWave.Services.Models.CommunicationRead, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
