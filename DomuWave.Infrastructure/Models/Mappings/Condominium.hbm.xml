<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.Condominium, DomuWave.Services" table="Condominium" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Condominium'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />

    <property name="Name" column="Name" type="String" length="200" not-null="true" />
    <property name="Description" column="Notes" type="String" length="2000" />
    <property name="Code" column="Code" type="String" length="50" />
    <property name="TaxCode" column="TaxCode" type="String" length="16" />
    <property name="VatNumber" column="VatNumber" type="String" length="11" />
    <property name="Email" column="Email" type="String" length="255" />
    <property name="Phone" column="Phone" type="String" length="20" />
    <property name="Pec" column="Pec" type="String" length="255" />
    <property name="NumberOfUnits" column="NumberOfUnits" type="Int32" not-null="true" />
    <property name="NumberOfStaircases" column="NumberOfStaircases" type="Int32" not-null="true" />
    <property name="NumberOfFloors" column="NumberOfFloors" type="Int32" />
    <property name="YearOfConstruction" column="YearOfConstruction" type="Int32" />
    <property name="TotalMillesimal" column="TotalMillesimal" type="Decimal" not-null="true" />
    <property name="HasElevator" column="HasElevator" type="Boolean" not-null="true" />
    <property name="NumberOfElevators" column="NumberOfElevators" type="Int32" />
    <property name="HasCentralHeating" column="HasCentralHeating" type="Boolean" not-null="true" />
    <property name="HasConcierge" column="HasConcierge" type="Boolean" not-null="true" />
    <property name="CommonAreasSqm" column="CommonAreasSqm" type="Decimal" />
    <property name="MandateStartDate" column="MandateStartDate" type="DateTime" />
    <property name="MandateEndDate" column="MandateEndDate" type="DateTime" />
    <property name="LastAssemblyDate" column="LastAssemblyDate" type="DateTime" />
    <property name="InstallmentFrequency" column="InstallmentFrequency" type="String" length="20" not-null="true" />
    <property name="InstallmentDueDay" column="InstallmentDueDay" type="Int32" not-null="true" />
    <property name="IsActive" column="IsActive" type="Boolean" not-null="true" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="IsEnabled" column="IsActive" type="Boolean" insert="false" update="false" />

    <one-to-one name="Address" class="DomuWave.Services.Models.CondominiumAddress, DomuWave.Services" property-ref="Condominium" cascade="all-delete-orphan" />
    <one-to-one name="CadastralData" class="DomuWave.Services.Models.CondominiumCadastralData, DomuWave.Services" property-ref="Condominium" cascade="all-delete-orphan" />

    <bag name="Units" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.RealEstateUnit, DomuWave.Services" />
    </bag>

    <bag name="MillesimalTables" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.MillesimalTable, DomuWave.Services" />
    </bag>

    <bag name="Accounts" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.ChartOfAccounts, DomuWave.Services" />
    </bag>

    <bag name="Budgets" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.Budget, DomuWave.Services" />
    </bag>

    <bag name="Expenses" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.Expense, DomuWave.Services" />
    </bag>

    <bag name="Installments" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.CondominiumInstallment, DomuWave.Services" />
    </bag>

    <bag name="Receipts" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.Receipt, DomuWave.Services" />
    </bag>

    <bag name="SupplierContracts" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.SupplierContract, DomuWave.Services" />
    </bag>

    <bag name="Documents" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.Document, DomuWave.Services" />
    </bag>

    <bag name="Communications" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.Communication, DomuWave.Services" />
    </bag>

    <bag name="Messages" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="CondominiumId" />
      <one-to-many class="DomuWave.Services.Models.Message, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
