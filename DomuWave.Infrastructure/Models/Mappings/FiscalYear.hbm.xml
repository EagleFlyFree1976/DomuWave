<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Infrastructure"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.FiscalYear, DomuWave.Services" table="FiscalYear" where="IsDeleted = 0">

    <id name="Id" column="FiscalYearId" type="int">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">100</param>
      </generator>
    </id>

    <!-- Multi-tenancy -->
    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant"
                 column="TenantId" not-null="true" lazy="false" fetch="join" />

    <!-- Relazione con Condominio -->
    <many-to-one name="Condominium" class="Condominium"
                 column="CondominiumId" not-null="true" lazy="false" fetch="join"
                 insert="true" update="true" />

    <!-- Campi principali -->
    <property name="Code"        column="Code"        type="string" length="50"  not-null="true" />
    <property name="Description" column="Description" type="string" length="200" not-null="false" />
    <property name="StartDate"   column="StartDate"   type="DateTime"            not-null="true" />
    <property name="EndDate"     column="EndDate"     type="DateTime"            not-null="true" />
    <many-to-one name="Status" class="FiscalYearStatus"
                 column="StatusId" not-null="true" lazy="false" fetch="join" />
    <property name="IsActive"    column="IsActive"    type="bool"                not-null="true" />

    <!-- Esercizio di provenienza (null per il primo esercizio) -->
    <many-to-one name="PreviousFiscalYear" class="FiscalYear"
                 column="PreviousFiscalYearId" not-null="false" lazy="false" fetch="join" />

    <!-- Campi di chiusura -->
    <property name="ClosingDate"     column="ClosingDate"     type="DateTime" not-null="false" />
    <property name="ClosedDate"      column="ClosedDate"      type="DateTime" not-null="false" />
    <property name="LockedDate"      column="LockedDate"      type="DateTime" not-null="false" />
    <property name="ClosedByUserId"  column="ClosedByUserId"  type="int"     not-null="false" />
    <property name="ClosingNotes"    column="ClosingNotes"    type="string"   length="500" not-null="false" />

    <!-- Audit (ereditati da TraceEntity) -->
    <property name="IsDeleted"           column="IsDeleted"           type="bool"   not-null="true" />
    <property name="CreationDate"        column="CreationDate"        type="datetime2" not-null="true" />
    <property name="CreatedBy"           column="CreatedBy"           type="int"   not-null="false" />
    <property name="CreatedByFullName"   column="CreatedByFullName"   type="string" length="200" not-null="false" />
    <property name="LastUpdateDate"      column="LastUpdateDate"      type="datetime2" not-null="false" />
    <property name="LastUpdatedBy"       column="LastUpdatedBy"       type="int"   not-null="false" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="string" length="200" not-null="false" />

    <!-- Collezioni lazy -->
    <bag name="Budgets" inverse="true" lazy="true" cascade="none">
      <key column="FiscalYearId" />
      <one-to-many class="Budget" />
    </bag>

    <bag name="Expenses" inverse="true" lazy="true" cascade="none">
      <key column="FiscalYearId" />
      <one-to-many class="Expense" />
    </bag>

    <bag name="Installments" inverse="true" lazy="true" cascade="none">
      <key column="FiscalYearId" />
      <one-to-many class="CondominiumInstallment" />
    </bag>
    <bag name="Payments" inverse="true" lazy="true">
	    <key column="FiscalYearId" />
	    <one-to-many class="Payment" />
    </bag>

  </class>
</hibernate-mapping>
