    </id>
    <property name="Id" column="Id" type="Guid" not-null="true" />
    <property name="DocumentId" column="DocumentoId" type="Int32" not-null="true" />
    <property name="UserId" column="UserId" type="Int64" not-null="true" />
    <property name="AccessDate" column="DataAccesso" type="DateTime" not-null="true" />
    <property name="AccessType" column="TipoAccesso" type="String" length="50" not-null="true" />
