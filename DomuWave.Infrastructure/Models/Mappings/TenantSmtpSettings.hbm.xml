<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.TenantSmtpSettings, DomuWave.Services" table="TenantSmtpSettings" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='TenantSmtpSettings'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />

    <property name="Name"              column="Name"              type="String"  length="200"  not-null="true" />
    <property name="Description"       column="Description"       type="StringClob" />
    <property name="Host"              column="Host"              type="String"  length="255"  not-null="true" />
    <property name="Port"              column="Port"              type="Int32"                 not-null="true" />
    <property name="UseSsl"            column="UseSsl"            type="Boolean"               not-null="true" />
    <property name="Username"          column="Username"          type="String"  length="255"  not-null="true" />
    <property name="PasswordEncrypted" column="PasswordEncrypted" type="String"  length="500"  not-null="true" />
    <property name="FromEmail"         column="FromEmail"         type="String"  length="255"  not-null="true" />
    <property name="FromName"          column="FromName"          type="String"  length="200"  not-null="true" />
    <property name="IsEnabled"         column="IsEnabled"         type="Boolean"               not-null="true" />

    <property name="CreatedBy"             column="CreatedById"           type="Int32"   not-null="true" />
    <property name="CreatedByFullName"     column="CreatedByFullName"     type="String"  length="200" />
    <property name="LastUpdatedBy"         column="LastUpdatedById"       type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String"  length="200" />
    <property name="IsDeleted"             column="IsDeleted"             type="Boolean" not-null="true" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

  </class>

</hibernate-mapping>
