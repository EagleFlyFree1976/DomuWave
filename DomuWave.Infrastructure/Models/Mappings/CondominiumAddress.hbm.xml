<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Domain"
                   namespace="DomuWave.Domain.Models">

  <class name="CondominiumAddress" table="CondominiumAddress" lazy="true">

    <id name="Id" column="AddressId" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='CondominiumAddress'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="Tenant" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="Condominium" column="CondominiumId" not-null="true" />

    <property name="Name" column="Street" type="String" length="200" not-null="true" />
    <property name="Description" column="City" type="String" length="100" not-null="true" />
    <property name="Street" column="Street" type="String" length="200" not-null="true" insert="false" update="false" />
    <property name="StreetNumber" column="StreetNumber" type="String" length="20" not-null="true" />
    <property name="PostalCode" column="PostalCode" type="String" length="10" not-null="true" />
    <property name="City" column="City" type="String" length="100" not-null="true" insert="false" update="false" />
    <property name="Province" column="Province" type="String" length="2" not-null="true" />
    <property name="Country" column="Country" type="String" length="2" not-null="true" />
    <property name="Latitude" column="Latitude" type="Decimal" />
    <property name="Longitude" column="Longitude" type="Decimal" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />

  </class>

</hibernate-mapping>
