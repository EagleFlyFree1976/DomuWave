<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.CondominiumFee, DomuWave.Services" table="CondominiumFee" lazy="true">

    <id name="Id" column="Id" type="Int64">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='CondominiumFee'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />
    <many-to-one name="Installment" class="DomuWave.Services.Models.CondominiumInstallment, DomuWave.Services" column="InstallmentId" not-null="true" />
    <many-to-one name="Unit" class="DomuWave.Services.Models.RealEstateUnit, DomuWave.Services" column="UnitId" not-null="true" />

    <property name="UserId" column="UserId" type="Int64" not-null="true" />
    <property name="AmountDue" column="AmountDue" type="Decimal" not-null="true" />
    <property name="AmountPaid" column="AmountPaid" type="Decimal" not-null="true" />
    <property name="Balance" column="Balance" type="Decimal" not-null="true" />
    <property name="PaymentStatus" column="PaymentStatus" type="String" length="50" not-null="true" />
    <property name="PaymentDate" column="PaymentDate" type="DateTime" />
    <property name="PaymentMethod" column="PaymentMethod" type="String" length="50" />
    
    <property name="Notes"        column="Notes"        type="String" length="500"  insert="false" update="false" />
    <property name="PaymentCode"  column="PaymentCode"  type="String" length="20"   not-null="true" />

    <property name="CreatedBy" column="CreatedById" type="Int32" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

    <bag name="Receipts" inverse="true" lazy="true">
      <key column="FeeId" />
      <one-to-many class="DomuWave.Services.Models.Receipt, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
