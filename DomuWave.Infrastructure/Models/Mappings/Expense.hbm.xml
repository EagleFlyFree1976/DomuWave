<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.Expense, DomuWave.Services" table="Expense" lazy="true">

    <id name="Id" column="Id" type="Int64">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Expense'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Services.Models.Condominium, DomuWave.Services" column="CondominiumId" not-null="true" />
    <many-to-one name="Account" class="DomuWave.Services.Models.ChartOfAccounts, DomuWave.Services" column="AccountId" not-null="true" />
    <many-to-one name="Supplier" class="DomuWave.Services.Models.Supplier, DomuWave.Services" column="SupplierId" />
    <many-to-one name="MillesimalTable" class="DomuWave.Services.Models.MillesimalTable, DomuWave.Services" column="MillesimalTableId" not-null="true" />
    <many-to-one name="FiscalYear"  class="DomuWave.Services.Models.FiscalYear,DomuWave.Services"     column="FiscalYearId"  not-null="true" />
    <property name="Name" column="Description" type="String" length="500" not-null="true" />
    <property name="Description" column="Notes" type="String" length="1000" />
    <property name="DocumentNumber" column="DocumentNumber" type="String" length="50" />
    <property name="DocumentDate" column="DocumentDate" type="DateTime" not-null="true" />
    <property name="RegistrationDate" column="RegistrationDate" type="DateTime" not-null="true" />
    <property name="TaxableAmount"          column="TaxableAmount"          type="Decimal" not-null="true" />
    <property name="TaxableAmountVatExempt" column="TaxableAmountVatExempt" type="Decimal" not-null="true" />
    <property name="GrossAmount"            column="GrossAmount"            type="Decimal" not-null="true" />
    <property name="VatAmount"              column="VatAmount"              type="Decimal" not-null="true" />
    <property name="NetAmount"              column="NetAmount"              type="Decimal" not-null="true" />
    <property name="PensionFund"            column="PensionFund"            type="Decimal" not-null="true" />
    <property name="WithholdingTax"         column="WithholdingTax"         type="Decimal" not-null="true" />
    <property name="StampDuty"              column="StampDuty"              type="Decimal" not-null="true" />
    <many-to-one name="ExpenseType" class="DomuWave.Services.Models.ExpenseType, DomuWave.Services" column="ExpenseTypeId" not-null="true" lazy="false" fetch="join" />
    <many-to-one name="PaymentStatus" class="DomuWave.Services.Models.ExpensePaymentStatus, DomuWave.Services" column="PaymentStatusId" not-null="true" lazy="false" fetch="join" />
    <property name="PaymentDate" column="PaymentDate" type="DateTime" />
    <many-to-one name="PaymentMethod" class="DomuWave.Services.Models.ExpensePaymentMethod, DomuWave.Services" column="PaymentMethodId" lazy="false" fetch="join" />
    <property name="DocumentPath" column="DocumentPath" type="String" length="500" />
    <property name="Notes" column="Notes" type="String" length="1000" insert="false" update="false" />
    <many-to-one name="ChargeabilityType" class="DomuWave.Services.Models.ChargeabilityType, DomuWave.Services" column="ChargeabilityType" not-null="true" lazy="false" fetch="join" />

    <property name="CreatedBy" column="CreatedById" type="Int32" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

    <bag name="Allocations" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="ExpenseId" />
      <one-to-many class="DomuWave.Services.Models.ExpenseAllocation, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
