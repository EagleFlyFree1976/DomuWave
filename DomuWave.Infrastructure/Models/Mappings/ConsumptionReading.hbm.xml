<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.ConsumptionReading, DomuWave.Services" table="ConsumptionReading" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='ConsumptionReading'</param>
      </generator>
    </id>

    <many-to-one name="Tenant"     class="DomuWave.Services.Models.Tenant, DomuWave.Services"     column="TenantId"     not-null="true" />
    <many-to-one name="Meter"      class="DomuWave.Services.Models.Meter, DomuWave.Services"      column="MeterId"      not-null="true" />
    <many-to-one name="FiscalYear" class="DomuWave.Services.Models.FiscalYear, DomuWave.Services" column="FiscalYearId" not-null="true" />

    <property name="InitialDate"  column="InitialDate"  type="datetime2" />
    <property name="InitialValue" column="InitialValue" type="Decimal"   not-null="true" />
    <property name="FinalDate"    column="FinalDate"    type="datetime2" />
    <property name="FinalValue"   column="FinalValue"   type="Decimal"   not-null="true" />
    <!-- Colonna calcolata persistita: insert=false update=false -->
    <property name="Consumption"  column="Consumption"  type="Decimal"   not-null="true" insert="false" update="false" />
    <property name="Notes"        column="Notes"        type="String"    length="1000" />
    <many-to-one name="Charge" class="DomuWave.Services.Models.ConsumptionCharge, DomuWave.Services" column="ChargeId" not-null="false" lazy="false" fetch="join" />

    <property name="CreatedBy"             column="CreatedById"           type="Int32"     not-null="true" />
    <property name="CreatedByFullName"     column="CreatedByFullName"     type="String"    length="200" />
    <property name="LastUpdatedBy"         column="LastUpdatedById"       type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String"    length="200" />
    <property name="IsDeleted"             column="IsDeleted"             type="Boolean"   not-null="true" />
    <property name="IsEnabled"             column="IsDeleted"             type="Boolean"   insert="false" update="false" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

  </class>

</hibernate-mapping>
