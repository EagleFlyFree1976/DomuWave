<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Domain"
                   namespace="DomuWave.Domain.Models">

  <class name="SupplierContract" table="SupplierContract" lazy="true">

    <id name="Id" column="ContractId" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='SupplierContract'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="Tenant" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="Condominium" column="CondominiumId" not-null="true" />
    <many-to-one name="Supplier" class="Supplier" column="SupplierId" not-null="true" />

    <property name="Name" column="Subject" type="String" length="200" not-null="true" />
    <property name="Description" column="Notes" type="String" length="1000" />
    <property name="ContractNumber" column="ContractNumber" type="String" length="50" />
    <property name="Subject" column="Subject" type="String" length="200" not-null="true" insert="false" update="false" />
    <property name="StartDate" column="StartDate" type="DateTime" not-null="true" />
    <property name="EndDate" column="EndDate" type="DateTime" />
    <property name="AnnualAmount" column="AnnualAmount" type="Decimal" />
    <property name="Frequency" column="Frequency" type="String" length="50" />
    <property name="AutoRenewal" column="AutoRenewal" type="Boolean" not-null="true" />
    <property name="Status" column="Status" type="String" length="50" not-null="true" />
    <property name="DocumentPath" column="DocumentPath" type="String" length="500" />
    <property name="Notes" column="Notes" type="String" length="1000" insert="false" update="false" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />

  </class>

</hibernate-mapping>
