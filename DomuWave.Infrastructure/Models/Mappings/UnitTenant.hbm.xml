<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.UnitTenant, DomuWave.Services" table="UnitTenant" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='UnitTenant'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, DomuWave.Services" column="OwnerTenantId" not-null="true" />
    <many-to-one name="Unit" class="DomuWave.Services.Models.RealEstateUnit, DomuWave.Services" column="UnitId" not-null="true" />

    <property name="UserId" column="UserId" type="Int64" not-null="true" />
    <property name="Name" column="LastName" type="String" length="100" not-null="true" />
    <property name="Description" column="Notes" type="String" length="500" />
    <property name="FirstName" column="FirstName" type="String" length="100" not-null="true" />
    <property name="LastName" column="LastName" type="String" length="100" not-null="true" insert="false" update="false" />
    <property name="TaxCode" column="TaxCode" type="String" length="16" />
    <property name="Email" column="Email" type="String" length="255" />
    <property name="Phone" column="Phone" type="String" length="20" />
    <property name="LeaseStartDate" column="LeaseStartDate" type="DateTime" not-null="true" />
    <property name="LeaseEndDate" column="LeaseEndDate" type="DateTime" />
    <property name="ContractPath" column="ContractPath" type="String" length="500" />
    <property name="IsActive" column="IsActive" type="Boolean" not-null="true" />
    <property name="Notes" column="Notes" type="String" length="500" insert="false" update="false" />

    <property name="CreatedBy" column="CreatedById" type="Int32" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="IsEnabled" column="IsActive" type="Boolean" insert="false" update="false" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

  </class>

</hibernate-mapping>
