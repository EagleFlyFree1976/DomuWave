<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Services"
                   namespace="DomuWave.Services.Models">

  <class name="DomuWave.Services.Models.Assembly, DomuWave.Services" table="Assembly" lazy="true">

    <id name="Id" column="Id" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Assembly'</param>
      </generator>
    </id>

    <many-to-one name="Tenant"       class="DomuWave.Services.Models.Tenant, DomuWave.Services"       column="TenantId"       not-null="true" />
    <many-to-one name="Condominium"  class="DomuWave.Services.Models.Condominium, DomuWave.Services"  column="CondominiumId"  not-null="true" />
    <many-to-one name="FiscalYear"   class="DomuWave.Services.Models.FiscalYear, DomuWave.Services"   column="FiscalYearId" />
    <many-to-one name="AssemblyType" class="DomuWave.Services.Models.AssemblyTypeLookup, DomuWave.Services"   column="AssemblyTypeId" not-null="true" lazy="false" fetch="join" />
    <many-to-one name="Status"       class="DomuWave.Services.Models.AssemblyStatusLookup, DomuWave.Services" column="StatusId"       not-null="true" lazy="false" fetch="join" />

    <property name="Name"          column="Title"         type="String"   length="200" not-null="true" />
    <property name="ScheduledDate" column="ScheduledDate" type="datetime2" not-null="true" />
    <property name="ActualDate"    column="ActualDate"    type="datetime2" />
    <property name="Location"      column="Location"      type="String"   length="200" />
    <property name="Description"   column="Description"   type="String"   length="500" />
    <property name="Notes"         column="Notes"         type="String" />
    <property name="MinutesPath"   column="MinutesPath"   type="String"   length="500" />
    <property name="BoardMembers"  column="BoardMembers"  type="String" />
    <property name="Minutes"       column="Minutes"       type="String" />

    <property name="CreatedBy"             column="CreatedById"           type="Int32"   not-null="true" />
    <property name="CreatedByFullName"     column="CreatedByFullName"     type="String"  length="200" />
    <property name="LastUpdatedBy"         column="LastUpdatedById"       type="Int32" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String"  length="200" />
    <property name="IsDeleted"             column="IsDeleted"             type="Boolean" not-null="true" />
    <property name="IsEnabled"             column="IsDeleted"             type="Boolean" insert="false" update="false" />
    <property name="CreationDate"          column="CreationDate"          type="datetime2" not-null="true" />
    <property name="LastUpdateDate"        column="LastUpdateDate"        type="datetime2" />

    <bag name="AgendaItems" inverse="true" cascade="all-delete-orphan" lazy="true" order-by="OrderIndex">
      <key column="AssemblyId" />
      <one-to-many class="DomuWave.Services.Models.AssemblyAgendaItem, DomuWave.Services" />
    </bag>

    <bag name="Attendances" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="AssemblyId" />
      <one-to-many class="DomuWave.Services.Models.AssemblyAttendance, DomuWave.Services" />
    </bag>

  </class>

</hibernate-mapping>
