<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Domain"
                   namespace="DomuWave.Domain.Models">

  <class name="DomuWave.Domain.Models.Document, Bizlio.Services" table="Document" lazy="true">

    <id name="Id" column="DocumentId" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Document'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, Bizlio.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Domain.Models.Condominium, Bizlio.Services" column="CondominiumId" not-null="true" />

    <property name="Name" column="Title" type="String" length="200" not-null="true" />
    <property name="Description" column="Description" type="String" length="1000" />
    <property name="Title" column="Title" type="String" length="200" not-null="true" insert="false" update="false" />
    <property name="Category" column="Category" type="String" length="100" not-null="true" />
    <property name="FileName" column="FileName" type="String" length="255" not-null="true" />
    <property name="FilePath" column="FilePath" type="String" length="500" not-null="true" />
    <property name="FileSize" column="FileSize" type="Int64" not-null="true" />
    <property name="MimeType" column="MimeType" type="String" length="100" not-null="true" />
    <property name="DocumentDate" column="DocumentDate" type="DateTime" />
    <property name="IsVisibleToOwners" column="IsVisibleToOwners" type="Boolean" not-null="true" />
    <property name="IsArchived" column="IsArchived" type="Boolean" not-null="true" />
    <property name="Tags" column="Tags" type="String" length="500" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />

    <bag name="Accesses" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="DocumentId" />
      <one-to-many class="DomuWave.Domain.Models.DocumentAccess, Bizlio.Services" />
    </bag>

  </class>

</hibernate-mapping>
