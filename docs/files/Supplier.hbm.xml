<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Domain"
                   namespace="DomuWave.Domain.Models">

  <class name="DomuWave.Domain.Models.Supplier, Bizlio.Services" table="Supplier" lazy="true">

    <id name="Id" column="SupplierId" type="Int32">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Supplier'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, Bizlio.Services" column="TenantId" not-null="true" />

    <property name="Name" column="CompanyName" type="String" length="200" not-null="true" />
    <property name="Description" column="Notes" type="String" length="1000" />
    <property name="CompanyName" column="CompanyName" type="String" length="200" not-null="true" insert="false" update="false" />
    <property name="VatNumber" column="VatNumber" type="String" length="11" />
    <property name="TaxCode" column="TaxCode" type="String" length="16" />
    <property name="Address" column="Address" type="String" length="300" />
    <property name="City" column="City" type="String" length="100" />
    <property name="Province" column="Province" type="String" length="2" />
    <property name="PostalCode" column="PostalCode" type="String" length="10" />
    <property name="Email" column="Email" type="String" length="255" />
    <property name="Phone" column="Phone" type="String" length="20" />
    <property name="Pec" column="Pec" type="String" length="255" />
    <property name="ContactPerson" column="ContactPerson" type="String" length="200" />
    <property name="SupplierType" column="SupplierType" type="String" length="100" />
    <property name="PaymentTerms" column="PaymentTerms" type="String" length="100" />
    <property name="IbanAccount" column="IbanAccount" type="String" length="34" />
    <property name="Notes" column="Notes" type="String" length="1000" insert="false" update="false" />
    <property name="IsActive" column="IsActive" type="Boolean" not-null="true" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />
    <property name="IsEnabled" column="IsActive" type="Boolean" insert="false" update="false" />

    <bag name="Contracts" inverse="true" cascade="all-delete-orphan" lazy="true">
      <key column="SupplierId" />
      <one-to-many class="DomuWave.Domain.Models.SupplierContract, Bizlio.Services" />
    </bag>

    <bag name="Expenses" inverse="true" lazy="true">
      <key column="SupplierId" />
      <one-to-many class="DomuWave.Domain.Models.Expense, Bizlio.Services" />
    </bag>

  </class>

</hibernate-mapping>
