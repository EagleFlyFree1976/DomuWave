<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="DomuWave.Domain"
                   namespace="DomuWave.Domain.Models">

  <class name="DomuWave.Domain.Models.Receipt, Bizlio.Services" table="Receipt" lazy="true">

    <id name="Id" column="ReceiptId" type="Int64">
      <generator class="hilo">
        <param name="table">hibernate_unique_key</param>
        <param name="column">next_hi</param>
        <param name="max_lo">10</param>
        <param name="where">entity_type='Receipt'</param>
      </generator>
    </id>

    <many-to-one name="Tenant" class="DomuWave.Services.Models.Tenant, Bizlio.Services" column="TenantId" not-null="true" />
    <many-to-one name="Condominium" class="DomuWave.Domain.Models.Condominium, Bizlio.Services" column="CondominiumId" not-null="true" />
    <many-to-one name="Fee" class="DomuWave.Domain.Models.CondominiumFee, Bizlio.Services" column="FeeId" />
    <many-to-one name="Unit" class="DomuWave.Domain.Models.RealEstateUnit, Bizlio.Services" column="UnitId" not-null="true" />

    <property name="Name" column="Description" type="String" length="500" not-null="true" />
    <property name="Description" column="Notes" type="String" length="500" />
    <property name="UserId" column="UserId" type="Int64" not-null="true" />
    <property name="ReceiptDate" column="ReceiptDate" type="DateTime" not-null="true" />
    <property name="RegistrationDate" column="RegistrationDate" type="DateTime" not-null="true" />
    <property name="Amount" column="Amount" type="Decimal" not-null="true" />
    <property name="PaymentMethod" column="PaymentMethod" type="String" length="50" not-null="true" />
    <property name="BankReference" column="BankReference" type="String" length="100" />
    <property name="ReconciliationStatus" column="ReconciliationStatus" type="String" length="50" not-null="true" />
    <property name="Notes" column="Notes" type="String" length="500" insert="false" update="false" />

    <property name="CreatedBy" column="CreatedById" type="Int64" not-null="true" />
    <property name="CreatedByFullName" column="CreatedByFullName" type="String" length="200" />
    <property name="LastUpdatedBy" column="LastUpdatedById" type="Int64" />
    <property name="LastUpdatedByFullName" column="LastUpdatedByFullName" type="String" length="200" />
    <property name="IsDeleted" column="IsDeleted" type="Boolean" not-null="true" />

  </class>

</hibernate-mapping>
